    {
      "title": "Show k-mer bin size distribution",
      "text": "%spark\n\n//Round bin size to nearest 100 (increase this for large datasets)\n//Spark SQL division is always floating point, so we use ceil() to get integers\nval adjusted = buckets.select($\"id\".as(\"id\"), \n    (ceil($\"totalAbundance\" / 100) * 100).as(\"abund\")).groupBy(\"abund\").agg(count(\"id\")).\n    orderBy(\"abund\")\nz.show(adjusted)\n\n",
      "user": "anonymous",
