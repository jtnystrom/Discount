    {
      "title": "Initial setup",
      "text": "%spark\n\nimplicit val sp = spark\n\nimport com.jnpersson.discount.spark._\nimport com.jnpersson.discount.bucket._\n\nimport com.jnpersson.kmers._\nimport com.jnpersson.kmers.minimizer._\n\n\n//Configure this\nval discountRoot = \"/path/to/Discount\"\n\n//First, a Discount object should be configured to set the overall behaviour of the framework.\n//val discount = Discount(k = 28)\n\n//Optional parameters can be used to control other behaviour, for example to normalize k-mer orientation:\nval discount = Discount(k = 31, normalize = false, ordering = Canonical(Frequency))\n//For normalized orientation, a canonical minimizer ordering such as Canonical(Frequency) must be used.\n\n//Example configuration to use the pregrouped counting method, which can be important for very large or repetitive datasets:\n//Valid methods are: Pregrouped, Simple, Auto (default)\n//val discount = Discount(k = 28, method = Pregrouped)",
      "user": "anonymous",
      "dateUpdated": "2026-07-08T23:22:17+0900",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/scala",
        "fontSize": 9,
        "title": true,
        "results": {},
        "enabled": true,
        "tableHide": false,
        "editorHide": false
      },
